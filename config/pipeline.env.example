# Copy OUTSIDE the repository to /mnt/state/pipeline.env; chmod 600.
# Literal KEY=value only. No command substitution or variable expansion.
BOARD_DATA_DIR=/mnt/state
BOARD_VOLUME_MOUNT=/mnt/state
BOARD_REQUIRE_VOLUME=1
BOARD_FETCHER=eastmoney
BOARD_REPO=YOUR_GITHUB_OWNER/YOUR_REPOSITORY
BOARD_SOURCE_BRANCH=main
BOARD_SSH_KEY=/mnt/state/id_deploy
BOARD_SITE_DIR=/opt/panda-board/dist
PANDASTACK_WORKER_ID=REPLACE_WITH_FIXED_WORKER_ID
PANDASTACK_APP_ID=REPLACE_WITH_APP_ID
PANDASTACK_API_KEY=__SET_REAL_KEY_OUTSIDE_GIT__
# Alternative to an SSH deploy key (leave one method configured):
# GITHUB_TOKEN=__SET_REAL_TOKEN_OUTSIDE_GIT__
# Optional bounded monthly rescan, default off; normal incremental runs already repair 90 days.
BOARD_MONTHLY_RESCAN=0
